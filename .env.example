# Database
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/llm_db

# Redis
REDIS_URL=redis://localhost:6379

# App
APP_ENV=development
LOG_LEVEL=INFO
MAX_CONVERSATION_HISTORY=20

# LLM Providers — set only the ones you have keys for
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ingestion (safe to leave as defaults)
REDIS_STREAM_NAME=inference_logs
REDIS_STREAM_MAXLEN=100000
INGESTION_CONSUMER_GROUP=ingestion
INGESTION_RETRY_AFTER_MS=30000
